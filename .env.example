# ──────────────────────────────────────────────────────
# Environment variables for the Bazaar microservice.
# Copy this file to .env and fill in the real values.
# NEVER commit .env with real credentials to the repo.
# ──────────────────────────────────────────────────────

APP_NAME=notifications-service
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=bazaar

# Notifications worker
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_SECONDS=10
NOTIFICATION_WORKER_BATCH_SIZE=10
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=30
